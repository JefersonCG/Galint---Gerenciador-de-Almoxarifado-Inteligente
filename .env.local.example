# Overrides locais por maquina. Este arquivo e ignorado pelo git.
# Copie para .env.local apenas na maquina que precisar de credenciais diferentes.

GALINT_DATABASE_URI=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/galint_db
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/galint_db
SQLALCHEMY_DATABASE_URI=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/galint_db
POSTGRES_PASSWORD=SUA_SENHA_AQUI

# Opcional: habilita leitura automática de rótulos/fotos no Telegram.
# GALINT_OPENAI_API_KEY=SUA_CHAVE_AQUI
# GALINT_VISION_MODEL=gpt-4o-mini
# Não ative em produção sem teste: similaridade pura de foto pode errar item.
# GALINT_ENABLE_PHOTO_SIMILARITY_GUESS=false