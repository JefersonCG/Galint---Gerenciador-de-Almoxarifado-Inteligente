<resources xmlns:tools="http://schemas.android.com/tools">
  <!-- Android 12+: a abertura do sistema mostraria o ícone pequeno no centro. Fica só o fundo
       escuro, e a marca do GALINT entra animada pelo app (App.js). -->
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowBackground">@drawable/ic_launcher_background</item>
    <item name="android:windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_vazio</item>
  </style>
</resources>
