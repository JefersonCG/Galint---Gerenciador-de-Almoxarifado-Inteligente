{
  "name": "galint-web",
  "version": "1.0.0",
  "private": true,
  "description": "Pipeline CSS do frontend web do GALINT.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./galint_flask/static/css/app.tailwind.css -o ./galint_flask/static/css/galint-modern.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./galint_flask/static/css/app.tailwind.css -o ./galint_flask/static/css/galint-modern.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}