# Copie este arquivo para .env e ajuste os valores abaixo.
# Se cada máquina usar credenciais diferentes, mantenha os valores comuns em .env
# e sobrescreva localmente em .env.local (arquivo ignorado pelo git).
# PostgreSQL-only
# Use uma das opções abaixo:
# - GALINT_DATABASE_URI (preferida)
# - DATABASE_URL
GALINT_DATABASE_URI=postgresql://galint:galint@db:5432/galint
DATABASE_URL=postgresql://galint:galint@db:5432/galint
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=galint
POSTGRES_USER=galint
POSTGRES_PASSWORD=galint

# Flask
FLASK_ENV=production

# Manutenção global durante atualização/implantação
# Também pode ser ativada criando o arquivo instance/system_maintenance.lock.
GALINT_MAINTENANCE_MODE=false
# GALINT_MAINTENANCE_MESSAGE=Sistema em atualização. Tente novamente em alguns minutos.

# Telegram (opcional)
# TELEGRAM_BOT_TOKEN=seu_token_aqui

# Identificação de itens por foto no Telegram (opcional)
# Sem uma chave de visão, o sistema usa comparação com fotos cadastradas e OCR local quando disponível.
# GALINT_OPENAI_API_KEY=sua_chave_aqui
# GALINT_VISION_MODEL=gpt-4o-mini
# Modo experimental: permite sugerir item apenas por foto parecida cadastrada.
# Mantemos desligado por padrão para evitar falso positivo operacional.
# GALINT_ENABLE_PHOTO_SIMILARITY_GUESS=false
GALINT_BACKUP_RETENTION_DAYS=30
GALINT_BACKUP_RETENTION_COUNT=20
