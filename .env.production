# CONFIGURAÇÃO POSTGRESQL PARA PRODUÇÃO
# Ajuste os valores e copie para .env no servidor

# === POSTGRESQL ===
GALINT_DATABASE_URI=postgresql://galint_user:SUA_SENHA_FORTE@localhost:5432/galint_db

# === SEGURANÇA ===
GALINT_SECRET_KEY=GERE-UMA-CHAVE-SECRETA-AQUI-USE-OPENSSL-RAND

# === DASHBOARD COMPARTILHADO ===
GALINT_DASHBOARD_TOKEN=token-seguro-compartilhamento-rede

# === BACKUPS POSTGRESQL ===
# Ajustar caminhos conforme instalação do PostgreSQL
GALINT_PG_DUMP=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
GALINT_PSQL=C:\Program Files\PostgreSQL\16\bin\psql.exe
GALINT_BACKUP_RETENTION_DAYS=30
GALINT_BACKUP_RETENTION_COUNT=20

# === FEATURES ===
GALINT_FEATURE_NOTAS=true
