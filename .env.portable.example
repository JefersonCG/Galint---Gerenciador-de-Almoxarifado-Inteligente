# Copie este arquivo para .env.portable dentro do pendrive e ajuste apenas os dados locais.
# O banco continua fora do pendrive. O Python portatil fica em portable_runtime\python\python.exe.

GALINT_DATABASE_URI=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/galint_db
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/galint_db

GALINT_FLASK_CONFIG=production
FLASK_ENV=production

# Mantem o sistema em janela unica.
GALINT_FEATURE_WORKSPACE_WINDOWS=0

# Ajustes operacionais padrao.
GALINT_TELEGRAM_KEEP_WEBHOOK=false
GALINT_TELEGRAM_POLLING=true
GALINT_DISABLE_BACKGROUND_SERVICES=false
